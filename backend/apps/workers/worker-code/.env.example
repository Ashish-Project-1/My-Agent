# Universal Agent — worker-code runtime configuration
# The worker reads environment variables at boot and validates them (see src/config.ts).
# This file is tracked and `scripts/check-env-example.mjs` keeps it in sync.

# Database (required) — the task pipeline the API wrote.
DATABASE_URL=

# Queue broker (required). Local compose ships Redis on 6379.
REDIS_URL=redis://127.0.0.1:6379

# Logging
LOG_LEVEL=info
