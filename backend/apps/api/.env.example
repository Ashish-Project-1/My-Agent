# Universal Agent â€” API runtime configuration
# The API reads environment variables at boot and validates them (see src/config.ts).
# This file is tracked and `scripts/check-env-example.mjs` keeps it in sync.

# Node/hosting
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Set to true when behind a reverse proxy (ingress, nginx, Cloudflare). Required to
# derive client IPs for rate limiting.
TRUST_PROXY=false

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Secrets
# Generate a long random string (at least 32 characters) for production.
AUTH_DIGEST_SECRET=replace-with-32-char-random-string

# Password hashing (Argon2id). The production floor is 19456 KiB and timeCost >= 2.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Sessions and refresh tokens
AUTH_SESSION_TTL_MINUTES=60
AUTH_REFRESH_TTL_DAYS=30

# Cookies
# Set COOKIE_SECURE to true only when serving over https. In development over http
# leave false. Production must be true â€” the config refuses to start otherwise.
COOKIE_SECURE=false
# Optional: share the cookie across a domain (e.g. ".example.com")
# COOKIE_DOMAIN=
# Per-account and per-IP failed-login window and cap (docs/planning/11 Â§5).
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Logging
LOG_LEVEL=info
