#!/bin/sh
# Pre-commit gate (docs/planning/17 Phase 1 "security work").
#
# Installed by `pnpm hooks:install`, which sets core.hooksPath to .githooks.
# Kept to the checks that are fast and need nothing built, so the hook does not
# become the reason people commit with --no-verify.
set -e

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found; skipping checks" >&2
  exit 0
fi

node scripts/scan-secrets.mjs --staged
node scripts/check-env-example.mjs
