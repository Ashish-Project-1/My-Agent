{
  "name": "universal-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first universal AI agent platform with an optional cloud control plane.",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "turbo run build --concurrency=4",
    "typecheck": "turbo run typecheck --concurrency=4",
    "test": "turbo run test --concurrency=4",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "turbo run test:e2e --concurrency=2",
    "lint": "biome check . && node scripts/check-module-boundaries.mjs",
    "format": "biome check --write .",
    "generate:openapi": "pnpm --filter @ua/contracts generate:openapi",
    "check:env": "node scripts/check-env-example.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "verify": "pnpm lint && pnpm check:env && pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
