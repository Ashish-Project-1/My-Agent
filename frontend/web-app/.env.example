# Where the server-side rewrite forwards `/v1/*`. The browser never sees it: it
# only ever talks to this app's own origin, so the session cookie stays
# first-party and the API needs no CORS (docs/planning/12 §4).
#
# Read before `next.config.ts` is evaluated, and `rewrites()` is baked into
# `.next/routes-manifest.json` — so set it before `next build`, not just before
# `next start`. Copy this file to `.env` (gitignored) to override the default.
API_ORIGIN=http://127.0.0.1:3000
