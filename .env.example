# Environment variables used by opencode.jsonc ({env:NAME} substitutions).
# Copy to .env and fill in ONLY the ones you need, then un-disable the matching
# server in opencode.jsonc. Never commit real values.
#
# These are read from the environment OpenCode itself runs in — export them in the
# shell/terminal you start OpenCode from (a .env file only works if your shell
# or launcher loads it).

# Code intelligence / docs
CONTEXT7_API_KEY=

# Databases
NEON_API_KEY=
MDB_MCP_CONNECTION_STRING=mongodb://localhost:27017

# Security
SEMGREP_APP_TOKEN=

# Infrastructure
TFE_TOKEN=
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=

# Research / scraping
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
